// แก้ไขจาก v5.7→v5.8:
//   Add: EmployeePin — auth แยกสำหรับพนักงาน offshore (MP Code + PIN, ไม่ใช่ User)
//   Add: LeaveRequest — ใบลา
//   Add: Candidate.workerConfirmStatus + JobConfirmationEvent — พนักงานยืนยัน/ปฏิเสธรับงาน
//        (แยกจาก MatchStatus เดิมที่เป็นสถานะ client อนุมัติ candidate)
//   Add: PPERequest, SafetyExam/SafetyExamAttempt — ผูกกับ Booking
//   Add: MedicalExamRecord.hdl/totalCholesterol/flaggedAbnormal
// ============================================================
// schema.prisma — MMS v5.7
// แก้ไขจาก v5.4→v5.5:
//   Fix: ลบ Company model + companyId ออกทั้งหมด (single-company)
//   Fix: Client.name → @unique
// แก้ไขจาก v5.5→v5.6:
//   Fix: Employee.status String → EmployeeStatus enum (active/inactive/resigned/suspended)
//   Fix: Booking.status String → BookingStatus enum (pending/approved/deployed/cancelled)
//   Fix: ClientApproval.status String → ApprovalStatus enum (pending/approved/rejected)
//   Fix: เพิ่ม Passport model — ใช้ใน Matching Engine (CV/Cert/Passport/Medical)
//        passport relation เพิ่มใน Employee (optional 1-to-1)
// ── SCHEMA FREEZE v5.6 — พร้อม Module 1 Matching Engine ──
// แก้ไขจาก v5.2:
//   Fix: TrainingMethod enum (INHOUSE/PUBLIC) + field ใน TrainingStandard -> XXXลบออกXXX
//   Fix: TrainingStandard validityMonths → validityDays + trainingHours
//   Fix: TrainingSource enum ใหม่ (COMPANY_ELEARNING/TPTI/CONTRACTOR/PUBLIC)
//   Fix: ลบ source[] ออกจาก GlobalTraining (เก็บใน TrainingStandard แทน)
//   Fix: EmployeeTraining.globalTrainingId → nullable (String?)
//        เพิ่ม rawTrainingName String? — เก็บชื่อดิบจาก Excel ทุก record
//        ลบ @@unique ที่มี nullable field — ใช้ index แทน
// แก้ไขจาก v5.4:
//   Fix: ลบ Company model + companyId ออกทั้งหมด
//        ระบบ single-company (EXPERTEAM only) — ไม่มี multi-tenant อีกต่อไป
//        Client ไม่ผูกกับ Company แล้ว, Subcontractor ไม่ผูกกับ Company แล้ว
//        ลบ @@unique([name, companyId]) ใน Client → ใช้ code @unique แทน
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum RequestStatus {
  draft
  submitted
  matching
  proposing
  waiting_customer
  approved
  rejected
  booked
  deployed
}

enum SelectionMode {
  auto
  manual
}

enum MatchStatus {
  proposed
  approved
  rejected
}

enum AssignmentStatus {
  planned
  active
  completed
  cancelled
}

enum CheckStatus {
  pending
  passed
  failed
  overdue
  due_soon
  not_required
}

enum AvailabilityStatus {
  available
  unavailable
}

enum TrainingStatus {
  completed // ปกติ — cert ยังไม่หมด
  due_soon // Due date — ใกล้หมดอายุ
  overdue // Over Due — หมดอายุแล้ว
  pending // Pending — ยังไม่มี cert
  if_required // If required — ทำเมื่อจำเป็น
  not_applicable // N/A
}

enum CandidateSource {
  internal
  ces
  contractor
}

// แก้ไข: RequirementLevel (S/B/A/A1) → RequirementType (M/R/X/O)
// ตรงกับ symbol จริงใน matrix Excel ของทุก client
enum RequirementType {
  mandatory // M — Erawan: บังคับทุกคน
  relevant // R — Erawan: เฉพาะบุคคลที่เกี่ยวข้อง (see SSHE Course Catalog)
  required // X — Chevron minimum required / PTT / Valeura
  assigned // O — Chevron: required as assigned by company
}

enum ContractType {
  manpower_supply // supply คน
  material_supply // supply material + คน
  maintenance // งาน maintain
  project // งาน project-based
}

enum GapType {
  training
  medical
}

enum GapStatus {
  passed // มีและยังไม่หมดอายุ
  missing // ยังไม่มีเลย
  overdue // มีแต่หมดอายุแล้ว
  due_soon // ใกล้หมดอายุ
}

// ADD 2: Subcontractor request lifecycle (จาก flowchart)
enum SubRequestStatus {
  inquiring // MP โทรถามจำนวนและ availability
  quote_requested // MP ส่ง email ขอ quote Cert/CV
  quote_received // ได้รับ price quote แล้ว
  sse_review // SSE กำลัง review CV/Cert
  approved // MP sign off hiring approval
  rejected // ไม่ผ่าน (cert ไม่ครบ / หาคนไม่ได้)
  cancelled // cancel
}

// ADD 3: MobilizationTask type (post-deploy tasks จาก flowchart)
enum MobilizationTaskType {
  vessel_booking // MP book ลงเรือ
  line_group // สร้างกลุ่มไลน์ + ดึงพนักงานเข้ากลุ่ม
  ppe_preparation // จัดเตรียม PPE
  transport_booking // book car / transport ขึ้น-ลงงาน
  hotel_booking // จองห้องพัก standby ล่วงหน้า 1 วัน
  accounting_notify // แจ้งการเดินทางไปยังฝ่ายบัญชี
  drug_test // ใบเบิกชุดตรวจสาร (defer — ยังมีคำถามเปิด)
  alcohol_test         // ใหม่ — ไฟล์ 1
  ppe_inspection       // ใหม่ — ไฟล์ 3 (คนละอันกับ ppe_preparation ที่เป็นการ "จัดเตรียม")
  pre_field_training   // ใหม่ — ไฟล์ 4
  baggage_inspection   // ใหม่ — ไฟล์ 5
  blood_pressure_check // ใหม่ — ไฟล์ 6
}

enum CheckResult {
  pass
  fail
  not_applicable
}

enum MobilizationTaskStatus {
  pending
  in_progress
  completed
  not_required
}

enum EmployeeStatus {
  active
  inactive
  resigned
  suspended
}

enum BookingStatus {
  pending
  approved
  deployed
  cancelled
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum WorkerMobilizationStatus {
  pending
  ready
  on_site
} 
//Pending = ยังขาดเอกสาร / training / medical
//Ready = พร้อมส่งขึ้นงานแล้ว
//On-Site = อยู่หน้างานแล้ว

enum SSELevel {
  new_sse   // "NEW SSE"
  sse1      // "SSE1"
  sse2      // "SSE2"
}

// ─── ENUMS (เพิ่ม) ─── Post-Project Review
enum ProjectStatus {
  active
  completed
}

enum RehireRecommendation {
  yes
  no
  maybe
}

// ─────────────────────────────────────────────────────────
// USER & RBAC
// ─────────────────────────────────────────────────────────

model User {
  id       String @id @default(uuid())
  titlePrefix String? // คำนำหน้าชื่อ เช่น "นาย" / "นาง" / "นางสาว" — เก็บแยกจาก name เพื่อไม่ให้กระทบ avatar initial / sort / search
  firstName   String?  // ชื่อ — แยกเก็บเพื่อเชื่อมระบบบัญชีกลาง
  lastName    String?  // นามสกุล
  name        String   // ชื่อแสดงผล = firstName + " " + lastName (backend ประกอบให้)
  email    String @unique
  
  externalAccountId String? @unique // id บัญชีในระบบกลาง (ใส่ตอนเชื่อมต่อ)

  password String
  phone       String?
  department  String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id]) // role หลัก

  extraRoles UserRole[] // role เสริม — 1 user มีได้หลาย role (เช่น manpower_supply + project_engineer)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  requests ManpowerRequest[] @relation("UserRequests")

  logs      WorkflowLog[]
  decisions ClientApproval[]

  reviews PerformanceReview[]

  notifications Notification[]

  trainingRequestBatches TrainingRequestBatch[]

  projectMessages ProjectMessage[]

  medicalRequestBatches MedicalRequestBatch[]

  auditLogs AuditLog[]

  createdAt        DateTime  @default(now())
  resetOtp         String?
  resetOtpExpireAt DateTime?

  // กันเดารหัสผ่าน — ผิดครบ 5 ครั้งล็อก 15 นาที (authController.login)
  failedLoginAttempts Int       @default(0)
  loginLockedUntil    DateTime?

  bansIssued EmployeeBan[] @relation("BansIssued")
  bansLifted EmployeeBan[] @relation("BansLifted")

  leaveApprovals LeaveRequest[] @relation("LeaveApprover")

  matchExceptionsRequested MatchExceptionRequest[] @relation("MatchExceptionRequester")
  matchExceptionsDecided   MatchExceptionRequest[] @relation("MatchExceptionDecider")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  users       User[]
  extraUsers  UserRole[]       // user ที่มี role นี้เป็น role เสริม
  permissions RolePermission[]
}

// role เสริมของ user — role หลักยังอยู่ที่ User.roleId (โค้ดเดิมที่อ่าน user.role ใช้ได้ต่อ)
// สิทธิ์ของ user = รวมทุก role (หลัก + เสริม) — admin ต้องเป็น role หลักเท่านั้น
model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model Permission {
  id          String           @id @default(uuid())
  resource    String
  action      String
  description String?
  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// COMPANY model ถูกลบออกแล้ว (v5.5)
// ระบบเปลี่ยนเป็น single-company (EXPERTEAM) ไม่มี multi-tenant
// CES จะเป็น Subcontractor ใน workflow ไม่ใช่ Company แยก

// ─────────────────────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────────────────────

model Client {
  id        String  @id @default(uuid())
  name      String  @unique // "Chevron" / "PTTEP" / "PTT" / "Valeura"
  shortName String? // "CHV" / "ER" / "PTT" / "VAL"
  type      String // "offshore" / "onshore" / "both"

  contracts           Contract[]
  medicalRequirements MedicalRequirement[]
  trainingStandards   TrainingStandard[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// FIX 4: CONTRACT LAYER
// Client → Contract → Project → ManpowerRequest
// แต่ละ contract มี matrix version และ position set ของตัวเอง
// Chevron Rev07 และ Rev08 จะเป็น 2 contract ต่างกัน
// ─────────────────────────────────────────────────────────

model Contract {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  contractNo    String? // เลขที่สัญญา
  name          String // "Erawan Offshore 2025", "Chevron CPP 2025"
  type          ContractType
  matrixVersion String? // "Rev07" / "V15" / "Review 02"
  matrixDate    DateTime?

  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)

  projects             Project[]
  clientTrainings      ClientTraining[]
  positionRequirements PositionRequirement[]

  createdAt DateTime @default(now())

  @@unique([clientId, contractNo])
}

// ─────────────────────────────────────────────────────────
// FIX 3: POSITION model
// normalize ชื่อตำแหน่ง ป้องกัน "Rigger" vs "Rigger/Scaffolder" ซ้ำกัน
// ─────────────────────────────────────────────────────────

model Position {
  id         String  @id @default(uuid())
  name       String  @unique // canonical name
  nameTH     String?
  category   String? // "Technical" / "Supervisory" / "Engineering"
  isOffshore Boolean @default(false)

  responsibilities String? @db.Text  // บรรทัดละ 1 ข้อ, คั่นด้วย \n
  assignments      Assignment[]      // ← เพิ่ม back-relation

  requirements          PositionRequirement[]
  employees             Employee[]             @relation("PrimaryPosition")
  requests              ManpowerRequest[]
  subcontractorRequests SubcontractorRequest[] // ADD 2
}

// ─────────────────────────────────────────────────────────
// EMPLOYEE
// ─────────────────────────────────────────────────────────

model Employee {
  id         String  @id @default(uuid())
  empCode    String  @unique

  fullName   String
  fullNameTH String?
  fullNameEN String?

  // รหัสพนักงานฝั่ง client ปัจจุบัน — เก็บแยกจาก empCode (รหัสภายใน EXPERTEAM)
  // ตั้งชื่อกลางๆ ไว้ก่อนเพราะตอนนี้มีแค่ Chevron client เดียว
  // ⚠️ ข้อจำกัด: field เดียวเก็บได้แค่ 1 client ต่อพนักงาน 1 คน — ถ้าอนาคตพนักงาน
  // คนเดียวต้องมีรหัสจากหลาย client พร้อมกัน (เช่น Chevron + PTT พร้อมกัน)
  // ต้องย้ายไปใช้ตารางแยก (เช่น ExternalEmployeeCode) แทน
  empId String? @unique // "ID Employee" จาก Excel ของ client ปัจจุบัน เช่น "38561733"

  // Contact Information
  nationality String?
  phone       String?
  email       String?

  // Optional
  notes       String? @db.Text

  birthDate DateTime?
  startWorkDate DateTime?

  status             EmployeeStatus     @default(active)
  availabilityStatus AvailabilityStatus @default(available)
  mobilizationStatus WorkerMobilizationStatus @default(pending)
  onSiteAt           DateTime? // ← เพิ่มตรงนี้ — timestamp ครั้งล่าสุดที่ mobilizationStatus เปลี่ยนเป็น on_site (ใช้แสดงใน Worker App timeline "มาถึง")

  division    String?
  workplace   String?  // ← ADD THIS LINE. col E "Chevron Workplace" from PE tracking Excel, e.g. "Benchamas"
  isOffshore  Boolean @default(false)

  positionId String?
  position Position? @relation("PrimaryPosition", fields: [positionId], references: [id])

  user User?

  covidVac    String?
  pdpaConsent Boolean?

  trainings     EmployeeTraining[]
  medicalChecks MedicalCheck[]
  skills        EmployeeSkill[]
  safetyChecks  SafetyCheck[]

  passport           Passport?
  candidates         Candidate[]
  assignments        Assignment[]
  bookings           Booking[]
  subcontractorHires SubcontractorHire[]

  trainingRequestItems TrainingRequestItem[]

  medicalExamRecords MedicalExamRecord[]

  medicalRequestItems MedicalRequestItem[]

  bans EmployeeBan[]

  // Allocation
  isPermanent  Boolean     @default(false)  // 🟩 เขียว = permanent
  healthRisk   String?                  // ความเสี่ยงสุขภาพ
  healthNote   String?     @db.Text   // หมายเหตุสุขภาพ (แยกจาก notes ทั่วไป)
  sseLevel     SSELevel?                    // NAME SSE
  sseCompleted Boolean?                     // NAME SSE Pass = Completed
  // birthDate, notes มีอยู่แล้ว — reuse

  address   String? @db.Text
  gender    String?
  height    Float?
  weight    Float?
  religion  String?
  language  String?
  education String?
  photoUrl  String?   // เก็บ path ก่อน — ระบบ upload ไฟล์จริงทำแยกทีหลัง

  pin EmployeePin?

  reviews PerformanceReview[]

  createdAt DateTime @default(now())

  leaveRequests       LeaveRequest[]
  ppeRequests         PPERequest[]
  safetyExamAttempts  SafetyExamAttempt[]

  matchExceptions MatchExceptionRequest[]
}

model EmployeePin {
  id             String    @id @default(uuid())
  employeeId     String    @unique
  employee       Employee  @relation(fields: [employeeId], references: [id])

  pinHash        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  // true = ยังใช้ PIN ที่ HR ตั้งให้ → ต้องตั้ง PIN ใหม่ก่อนใช้งาน Worker App
  mustChange     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// FIX 1A: GLOBAL TRAINING
// หลักสูตรกลาง — canonical, dedup ข้าม client
// เช่น BOSIET = 1 record เท่านั้น
// ─────────────────────────────────────────────────────────

model GlobalTraining {
  id          String  @id @default(uuid())
  name        String  @unique // canonical name — dedup ข้าม client
  fullName    String? // ชื่อเต็มจาก Excel (for display)
  description String?

  // source ไม่เก็บที่นี่ — อยู่ใน TrainingStandard แทน
  // GlobalTraining คือ canonical name กลาง ไม่รู้จัก client/source

  trainingStandards TrainingStandard[]
  clientTrainings   ClientTraining[]
  employeeTrainings EmployeeTraining[]
  candidateGaps     CandidateGap[] // FIX A: FK จาก CandidateGap

  trainingRequestItems TrainingRequestItem[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// FIX 1B: CLIENT TRAINING
// Override / alias ของ GlobalTraining ต่อ Contract
// เช่น Chevron เรียก "Basic Rigging (DNV GL)" แต่ global คือ "Basic Rigging"
// ─────────────────────────────────────────────────────────

model TrainingSourceOption {
  id             String   @id @default(uuid())
  name           String   @unique // เช่น "Company", "TPTI", "Safety" — เพิ่ม/ลบเองได้จากหน้า Manage Trainings
  requiresClient Boolean  @default(false) // true = ต้องเลือก client ตอนสร้าง standard (เดิมคือ source = COMPANY)
  createdAt      DateTime @default(now())

  trainingStandards TrainingStandard[]
}

model TrainingStandard {
  id String @id @default(uuid())

  globalTrainingId String

  sourceId String
  source   TrainingSourceOption @relation(fields: [sourceId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  trainingHours Int?
  validityDays  Int?
  isNoExpiry    Boolean @default(false)

  globalTraining GlobalTraining @relation(fields: [globalTrainingId], references: [id])

  clientTrainings ClientTraining[]

  createdAt DateTime @default(now())

  @@unique([globalTrainingId, sourceId, clientId])
}

model ClientTraining {
  id               String @id @default(uuid())
  globalTrainingId String
  contractId       String

  nameAlias String? // ชื่อที่ใช้ใน Excel ของ client นี้

  completionPeriodCode String?

  trainingStandardId String

  globalTraining   GlobalTraining   @relation(fields: [globalTrainingId], references: [id])
  contract         Contract         @relation(fields: [contractId], references: [id])
  trainingStandard TrainingStandard @relation(fields: [trainingStandardId], references: [id])

  requirements      PositionRequirement[]
  employeeTrainings EmployeeTraining[]    @relation("ClientTrainingRecord")

  @@unique([globalTrainingId, contractId])
}

// ─────────────────────────────────────────────────────────
// POSITION REQUIREMENT (Training Matrix)
// Position X ต้องการ ClientTraining Z ใน Contract Y
//
// requirementType — symbol จริงจาก matrix Excel:
//   mandatory (M) — Erawan: บังคับทุกคน
//   relevant  (R) — Erawan: เฉพาะผู้เกี่ยวข้อง
//   required  (X) — Chevron minimum, PTT, Valeura
//   assigned  (O) — Chevron: required as assigned by company
//
// sourceMatrixCode  — symbol ดิบจาก Excel ("M","R","X","O") — audit
// sourceMatrixSheet — ชื่อ sheet/version ที่ import มา — debug
// ─────────────────────────────────────────────────────────

model PositionRequirement {
  id               String @id @default(uuid())
  positionId       String
  clientTrainingId String
  contractId       String

  requirementType   RequirementType // แทน requirementLevel เดิม
  sourceMatrixCode  String? // symbol ดิบจาก Excel: "M","R","X","O"
  sourceMatrixSheet String? // "Chevron Matrix 2025(14-11-25)" / "Erawan Rev15"

  position       Position       @relation(fields: [positionId], references: [id])
  clientTraining ClientTraining @relation(fields: [clientTrainingId], references: [id])
  contract       Contract       @relation(fields: [contractId], references: [id])

  @@unique([positionId, clientTrainingId, contractId])
}

// ─────────────────────────────────────────────────────────
// MEDICAL REQUIREMENT (per client)
// ─────────────────────────────────────────────────────────

model MedicalRequirement {
  id             String @id @default(uuid())
  clientId       String
  name           String // "Medical Check up (Chevron) 1 YEAR"
  validityMonths Int

  client        Client         @relation(fields: [clientId], references: [id])
  checks        MedicalCheck[]
  candidateGaps CandidateGap[] // FIX A: FK จาก CandidateGap

  @@unique([clientId, name])
}

// ─────────────────────────────────────────────────────────
// FIX 2 + FIX C + v5.4: EMPLOYEE TRAINING RECORD
// isLatest = true → record ที่ใช้งานจริง
// isLatest = false → history (audit trail)
//
// globalTrainingId nullable — รองรับ cert ที่ยังไม่มี mapping
// rawTrainingName — เก็บชื่อดิบจาก Excel เมื่อ globalTrainingId = null
//
// Two cases:
//   mapped:   globalTrainingId = uuid, rawTrainingName = original Excel name
//   unmapped: globalTrainingId = null, rawTrainingName = original Excel name
// ─────────────────────────────────────────────────────────

model EmployeeTraining {
  id               String  @id @default(uuid())
  employeeId       String
  globalTrainingId String? // null = ยังไม่มี canonical mapping
  rawTrainingName  String? // ชื่อดิบจาก Excel — เก็บเสมอเพื่อ audit
  contractId       String? // null = record ทั่วไป ไม่ผูก contract
  clientTrainingId String? // อ้างอิง ClientTraining (optional)

  completedDate DateTime?
  expiryDate    DateTime?
  remindDate    DateTime?
  remindDays    Int? // วันที่เหลือ (จาก Excel)

  status     TrainingStatus @default(pending)
  source     String? // "excel_import" / "manual" / "hr_system"
  sourceFile String? // ชื่อไฟล์ Excel

  institute String?

  // ── เพิ่มใหม่: ไฟล์แนบ cert (รูป/PDF) — อัปโหลดโดย user ──
  certFileUrl  String?  // path ไปยังไฟล์ เช่น "/uploads/certs/xxx.jpg"
  certFileName String?  // ชื่อไฟล์เดิม สำหรับแสดงผล/download

  // FIX C: version history — ไม่ลบ record เก่า แต่ mark isLatest = false
  // เมื่อ update cert ใหม่ → สร้าง record ใหม่ version+1, isLatest=true
  //                        → record เก่า isLatest=false (ยังอยู่ใน DB)
  version  Int     @default(1)
  isLatest Boolean @default(true) // query ปกติ filter isLatest=true เสมอ

  employee       Employee        @relation(fields: [employeeId], references: [id])
  globalTraining GlobalTraining? @relation(fields: [globalTrainingId], references: [id])
  clientTraining ClientTraining? @relation("ClientTrainingRecord", fields: [clientTrainingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ลบ @@unique ที่มี nullable field ออก
  // เพราะ PostgreSQL: NULL != NULL → duplicate ได้ไม่ถูก enforce
  // ใช้ index แทน + enforce uniqueness ที่ application layer
  @@index([employeeId, globalTrainingId, isLatest])
  @@index([employeeId, isLatest])
  @@index([expiryDate, isLatest]) // สำหรับ cert alert / due_soon query
}

// ─────────────────────────────────────────────────────────
// MEDICAL CHECK
// ─────────────────────────────────────────────────────────

model MedicalCheck {
  id                   String  @id @default(uuid())
  employeeId           String
  medicalRequirementId String? // FK → MedicalRequirement

  checkType  String // "Medical Check up" / "Confined Space Entry"
  hospital   String?
  formType String?
  issuedDate DateTime?
  expiryDate DateTime?
  remindDate DateTime?
  remindDays Int?
  status     CheckStatus @default(pending)
  notes      String?     @db.Text

  examRecord MedicalExamRecord?

  employee           Employee            @relation(fields: [employeeId], references: [id])
  medicalRequirement MedicalRequirement? @relation(fields: [medicalRequirementId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, checkType, medicalRequirementId])
}

// ─────────────────────────────────────────────────────────
// MEDICAL EXAM RECORD — ผลตรวจสุขภาพประจำปีแบบละเอียด (PE tracking)
// 1 employee มีได้หลาย record (ตรวจทุกปี) — isLatest แบบเดียวกับ EmployeeTraining
// เชื่อมกับ MedicalCheck (checkType="Medical Check up") แบบ optional
// เพื่อให้ expiry logic เดิม (getMedicalExpiryBucket) ยังใช้ได้โดยไม่ต้องเขียนใหม่
// ─────────────────────────────────────────────────────────

model MedicalExamRecord {
  id             String  @id @default(uuid())
  employeeId     String
  medicalCheckId String? @unique

  examDate DateTime? // col K วันที่ตรวจร่างกาย

  // ── Vitals ──
  height        Float? // col L
  weight        Float? // col M
  bmi           Float? // col N
  bpSystolic    Int? // col O
  bpDiastolic   Int? // col P
  hematocritPct Float? // col Q

  // ── Urine ──
  urineResult       String? // col R
  urineAbnormalNote String? @db.Text // col S

  // ── Blood chemistry ──
  bloodSugar   Float? // col T
  ldl          Float? // col U
  triglyceride Float? // col V
  sgot         Float? // col W
  sgpt         Float? // col X
  uricAcid     Float? // col Y

  // ── EKG / Chest X-ray / Dental / EST ──
  ekgResult             String? // col Z
  ekgAbnormalNote       String? @db.Text // col AA
  chestXrayResult       String? // col AB
  chestXrayAbnormalNote String? @db.Text // col AC
  dentalResult          String? // col AD
  dentalAbnormalNote    String? @db.Text // col AE
  estResult             String? // col AF
  estAbnormalNote       String? @db.Text // col AG

  chronicDisease String? // col J โรคประจำตัว (เช่น "ไม่มี (No)", "เบาหวาน", "ความดัน")
  note           String? @db.Text // col AH

  // ── สรุปผล ──
  healthRisk     String? // col AI
  recommendation String?     @db.Text // col AJ
  commentDate    DateTime? // col AK — base date สำหรับ getFollowUpStatus() runtime

  // ── การติดตามผล (PE tracking layout ใหม่ col AN..AR, AU) ──
  // AL/AM/AS/AT เป็นค่าคำนวณ — ไม่เก็บ (คำนวณจาก commentDate / examDate)
  followUpTopic         String?   @db.Text // col AN เรื่องที่ต้องติดตาม
  followUpNotice        String? // col AO แจ้งเมื่อมีให้ติดตาม (เช่น "แจ้งแล้ว")
  followUpRemindBefore  String? // col AP แจ้งซ้ำก่อนกำหนด 1 เดือน ติดตาม
  followUpRemindOverdue String? // col AQ แจ้งซ้ำเมื่อเลยกำหนดติดตาม
  followUpSchedule      String? // col AR กำหนดการติดตาม (ข้อความ/วันที่ตามที่ HR กรอก)
  nextExamDate          DateTime? // col AU กำหนดการตรวจครั้งถัดไป

  // ── version history — เหมือน EmployeeTraining ──
  version  Int     @default(1)
  isLatest Boolean @default(true)

  source     String? // "excel_import" / "manual"
  sourceFile String?

  employee     Employee      @relation(fields: [employeeId], references: [id])
  medicalCheck MedicalCheck? @relation(fields: [medicalCheckId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hdl              Float?  // ยังไม่มีใน schema เดิม (มีแค่ ldl, triglyceride)
  totalCholesterol Float?  // ยังไม่มีใน schema เดิม
  flaggedAbnormal  Boolean @default(false) // ใช้แสดงใน "รายการที่ควรติดตาม" ฝั่งพนักงาน

  @@index([employeeId, isLatest])
}

// ─────────────────────────────────────────────────────────
// SAFETY CHECK
// ─────────────────────────────────────────────────────────

model SafetyCheck {
  id         String      @id @default(uuid())
  employeeId String
  requestId  String?
  status     CheckStatus @default(pending)
  notes      String?

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// SKILL
// ─────────────────────────────────────────────────────────

model Skill {
  id        String          @id @default(uuid())
  name      String          @unique
  employees EmployeeSkill[]
}

model EmployeeSkill {
  id         String @id @default(uuid())
  employeeId String
  skillId    String
  level      Int // 1-5

  employee Employee @relation(fields: [employeeId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([employeeId, skillId])
}

// ─────────────────────────────────────────────────────────
// PROJECT (ผูกกับ Contract — ไม่ใช่ Client โดยตรง)
// ─────────────────────────────────────────────────────────

model Project {
  id         String   @id @default(uuid())
  name       String
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  masterProjectRecordId String?   
  masterProjectRecord   MasterProjectRecord? @relation(fields: [masterProjectRecordId], references: [id])

  location   String?
  notes      String?  @db.Text
  isOffshore Boolean  @default(false)


  travelMode   String? // ขาไป — "boat" / "helicopter" / "vehicle" / "other" หรือข้อความที่พิมพ์เอง
  responseDays Int     @default(10) // พนักงานต้องตอบรับภายในกี่วัน นับจากวันที่ approve ที่หน้า Allocation

  startDate  DateTime?
  endDate    DateTime?

  cvLabel String?  // ข้อความแสดงในเรซูเม่ ถ้าว่างจะ fallback ไปใช้ name

  requests    ManpowerRequest[]
  assignments Assignment[]

  status     ProjectStatus       @default(active)
  reviews    PerformanceReview[]

  messages    ProjectMessage[]   // ← เพิ่มบรรทัดนี้

  createdAt DateTime @default(now())
}

model MasterProjectRecord {
  id String @id @default(uuid())

  owner        String?  // เจ้าของงาน — string เฉยๆ ไม่ผูก User
  year         Int
  projectCode  String   @unique // "Project On" เช่น "ON/015-01/2024"
  jobTitle     String   // "Project / Job"
  ccNo         String?  // "CC. No."
  engineer     String?  // "Project Engineer" — string เฉยๆ ไม่ผูก User
  customerName String?  // "Customer Name"
  wrPoSr       String?  // "WR / PO / SR"
  woAfe        String?  // "WO / AFE"
  wa           String?  // "WA"
  exptEq       String?  // "Expt EQ" — raw string ตามต้นฉบับ
  termOfPaymentDays Int?
  company      String?
  team         String?
  paymentTerms String?
  totalValue   Decimal? @db.Decimal(14, 2)

  linkedProjects Project[]

  sourceFile String?
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([year])
  @@index([company])
}

// ─────────────────────────────────────────────────────────
// MANPOWER REQUEST
// ─────────────────────────────────────────────────────────

model ManpowerRequest {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  quantity Int

  startDate  DateTime?
  endDate    DateTime?
  isOffshore Boolean   @default(false)

  selectionMode SelectionMode @default(manual)
  status        RequestStatus @default(draft)

  requestedById String
  requestedBy   User   @relation("UserRequests", fields: [requestedById], references: [id])

  rounds                CandidateRound[]
  bookings              Booking[]
  clientApproval        ClientApproval[]
  sseRecords            SSERecord[] // ADD 1
  subcontractorRequests SubcontractorRequest[] // ADD 2

  matchExceptions MatchExceptionRequest[]

  createdAt   DateTime      @default(now())
  WorkflowLog WorkflowLog[]
}

// ─────────────────────────────────────────────────────────
// ROUND SYSTEM
// ─────────────────────────────────────────────────────────

model CandidateRound {
  id        String @id @default(uuid())
  requestId String
  round     Int

  request    ManpowerRequest @relation(fields: [requestId], references: [id])
  candidates Candidate[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// CANDIDATE + FIX 5: CANDIDATE GAP (explainable matching)
// ─────────────────────────────────────────────────────────

model Candidate {
  id         String @id @default(uuid())
  roundId    String
  employeeId String

  sourceType CandidateSource
  status     MatchStatus     @default(proposed)

  // FIX B: ย้าย score ออกไป CandidateScore แทน
  // totalScore และ matchPct คำนวณจาก score breakdown
  totalScore Int // sum ของทุก score component
  matchPct   Float? // % cert match รวม (Module 1)

  round    CandidateRound  @relation(fields: [roundId], references: [id])
  employee Employee        @relation(fields: [employeeId], references: [id])
  decision ClientApproval?
  gaps     CandidateGap[]
  score    CandidateScore? // FIX B: score breakdown

  workerConfirmStatus WorkerConfirmStatus     @default(pending)
  confirmationEvents  JobConfirmationEvent[]
}

// FIX B: Score breakdown — แยกคะแนนแต่ละด้านออกมา
model CandidateScore {
  id          String @id @default(uuid())
  candidateId String @unique

  certScore         Int @default(0) // training match score (0-100)
  medicalScore      Int @default(0) // medical fitness score (0-100)
  experienceScore   Int @default(0) // experience score (0-100)
  availabilityScore Int @default(0) // availability score (0-100)

  // default: cert 50% + medical 30% + experience 10% + availability 10%
  totalScore Int @default(0)

  computedAt DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

// FIX 5 + FIX A: CandidateGap — explainable matching
model CandidateGap {
  id          String    @id @default(uuid())
  candidateId String
  gapType     GapType // training / medical
  status      GapStatus // passed / missing / overdue / due_soon

  globalTrainingId     String?
  medicalRequirementId String?

  itemName     String // "BOSIET" / "Medical Check up (Chevron)" — snapshot
  itemCategory String? // "offshore" / "medical"

  globalTraining     GlobalTraining?     @relation(fields: [globalTrainingId], references: [id])
  medicalRequirement MedicalRequirement? @relation(fields: [medicalRequirementId], references: [id])
  candidate          Candidate           @relation(fields: [candidateId], references: [id])
}

// ─────────────────────────────────────────────────────────
// CUSTOMER DECISION
// ─────────────────────────────────────────────────────────

model ClientApproval {
  id          String         @id @default(uuid())
  candidateId String         @unique
  requestId   String
  decidedById String?
  status      ApprovalStatus @default(pending)
  comment     String?

  candidate Candidate       @relation(fields: [candidateId], references: [id])
  request   ManpowerRequest @relation(fields: [requestId], references: [id])
  user      User?           @relation(fields: [decidedById], references: [id])

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// BOOKING → ASSIGNMENT
// ─────────────────────────────────────────────────────────

model Booking {
  id         String @id @default(uuid())
  requestId  String
  employeeId String

  status BookingStatus @default(pending)

  request  ManpowerRequest @relation(fields: [requestId], references: [id])
  employee Employee        @relation(fields: [employeeId], references: [id])

  assignment        Assignment?
  mobilizationTasks MobilizationTask[] // ADD 3

  createdAt DateTime @default(now())

  ppeRequests        PPERequest[]
  safetyExamAttempts SafetyExamAttempt[]
}

model Assignment {
  id         String           @id @default(uuid())
  bookingId  String?          @unique   // nullable — roster snapshot ไม่ได้มาจาก booking flow
  employeeId String
  projectId  String?                    // nullable — roster ไม่ผูก project
  status     AssignmentStatus

  // Allocation
  mobDate    DateTime?  // MOB — วันลงแท่น
  demobDate  DateTime?  // D-MOB — วันกำหนดกลับ
  platform   String?    // แท่น เช่น BELQ, C5 (≠ Project.location)
  fromLocation String?    // ← ใหม่ จุดเริ่มต้นก่อน mob ครั้งนี้ (From)
  remark     String?   // ← เพิ่มบรรทัดนี้ — "ขึ้นด่วน" / "ติดงาน Project" ฯลฯ
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  positionId String?     // snapshot ตำแหน่งตอน deploy
  positionLabel String?  // ตำแหน่ง ณ รอบนั้นตามที่ HR กรอก (ประวัติลงงาน) — แยกจากตำแหน่งปัจจุบัน
  position   Position?   @relation(fields: [positionId], references: [id])

  projectLabel String?  // ← ใช้เมื่อ projectId = null (manual/historical entry จาก HR)

  // ประวัติเดินทาง (Past Deployment History — ตามไฟล์ "แจ้งการเดินทางกลับ" ของ HR)
  travelTeamNo String?  // Traveling Team No. เช่น "Chevron On.Q000"
  travelOut    String?  // ขาไป  เช่น "เรือ สัตหีบ"
  travelBack   String?  // ขากลับ เช่น "เรือ สัตหีบ"
  field        String?  // Field / Block เช่น B8/32

  booking  Booking?  @relation(fields: [bookingId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])
}

// ─────────────────────────────────────────────────────────
// PASSPORT
// ใช้ใน Matching Engine — Passport หมดอายุ = ไม่ผ่าน deploy
// ─────────────────────────────────────────────────────────

model Passport {
  id         String @id @default(uuid())
  employeeId String @unique

  // Passport
  passportNo String?
  issueDate  DateTime?
  expiryDate DateTime?

  // Work Permit
  workPermitNo         String?
  workPermitExpiryDate DateTime?

  // status คำนวณ runtime จาก expiryDate ไม่ต้อง store
  // แต่ถ้าอยากเก็บ snapshot ใช้ CheckStatus ได้
  status CheckStatus @default(pending)

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// WORKFLOW LOG
// ─────────────────────────────────────────────────────────

model WorkflowLog {
  id String @id @default(uuid())

  requestId String
  userId    String?

  action  String
  comment String?

  user User? @relation(fields: [userId], references: [id])

  request ManpowerRequest @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────
// ADD 1: SSE RECORD
// ─────────────────────────────────────────────────────────

model SSERecord {
  id        String @id @default(uuid())
  requestId String

  round Int @default(1) // Fix 1: รองรับ resubmit

  totalSSE     Int
  onboardCount Int
  onboardPct   Float

  documentNotes String?
  submittedById String?
  submittedAt   DateTime @default(now())

  request ManpowerRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, round])
  @@index([requestId])
}

// ─────────────────────────────────────────────────────────
// ADD 2: SUBCONTRACTOR
// ─────────────────────────────────────────────────────────

model Subcontractor {
  id           String  @id @default(uuid())
  name         String
  contactName  String?
  contactTel   String?
  contactEmail String?

  isActive Boolean @default(true)
  notes    String?

  requests SubcontractorRequest[]

  createdAt DateTime @default(now())

  priority Int @default(99)
}

model SubcontractorRequest {
  id              String @id @default(uuid())
  requestId       String
  subcontractorId String
  positionId      String
  quantity        Int

  status SubRequestStatus @default(inquiring)

  quoteSentAt     DateTime?
  quoteReceivedAt DateTime?
  quotedPrice     Float?
  quoteCurrency   String?   @default("THB")

  sseReviewedAt   DateTime?
  sseReviewedById String?
  sseReviewNotes  String?

  signedOffAt   DateTime?
  signedOffById String?

  hires SubcontractorHire[]

  cancelReason String?

  manpowerRequest ManpowerRequest @relation(fields: [requestId], references: [id])
  subcontractor   Subcontractor   @relation(fields: [subcontractorId], references: [id])
  position        Position        @relation(fields: [positionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([subcontractorId])
}

// Fix 2: junction table แทน hiredEmployeeIds String[]
model SubcontractorHire {
  id                     String @id @default(uuid())
  subcontractorRequestId String
  employeeId             String

  startDate DateTime?
  notes     String?

  subcontractorRequest SubcontractorRequest @relation(fields: [subcontractorRequestId], references: [id])
  employee             Employee             @relation(fields: [employeeId], references: [id])

  @@unique([subcontractorRequestId, employeeId])
}

// ─────────────────────────────────────────────────────────
// ADD 3: MOBILIZATION TASK
// ─────────────────────────────────────────────────────────

model MobilizationTask {
  id        String @id @default(uuid())
  bookingId String

  taskType MobilizationTaskType
  status   MobilizationTaskStatus @default(pending)

  notes       String?
  dueDate     DateTime?
  completedAt DateTime?
  completedBy String?

  resultStatus  CheckResult? // null = logistics task ทั่วไป, ใช้จริงเฉพาะ checklist type
  checkedById   String?
  checkedAt     DateTime?
  measuredValue String?      // เก็บค่าที่วัด เช่น "0.00 mg%", "120/80"

  itemsChecked  Json?        // ← ใหม่: สำหรับ task ที่มี checklist ย่อยหลายชิ้น เช่น PPE (array of {item, checked})

  vesselName     String?
  departureDate  DateTime?
  transportType  String?
  pickupLocation String?
  hotelName      String?
  checkInDate    DateTime?
  checkOutDate   DateTime?
  lineGroupName  String?
  lineGroupUrl   String?

  booking Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([taskType, status])
}

// ─── MODEL ใหม่ ─── Post-Project Review
model PerformanceReview {
  id         String @id @default(uuid())
  employeeId String
  projectId  String

  rating  Int                  // 1-5 ดาว
  rehire  RehireRecommendation @default(maybe)
  comment String?              @db.Text

  reviewedById String?

  employee   Employee @relation(fields: [employeeId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])
  reviewedBy User?    @relation(fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, projectId])   // 1 review ต่อคนต่อ project (upsert)
  @@index([projectId])
}

model Division {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "project_created" / "cert_expiring" / ... (เผื่ออนาคต)
  title     String
  message   String?
  link      String?  // เช่น "/projects/{id}" — กดแล้วพาไปหน้าที่เกี่ยวข้อง
  isRead    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model TrainingRequestBatch {
  id            String   @id @default(uuid())
  requestedById String?
  status        String   @default("pending")
  requestedBy   User?    @relation(fields: [requestedById], references: [id])

  requestedStart DateTime? // วันที่ผู้ขอต้องการ (จาก)
  requestedEnd   DateTime? // วันที่ผู้ขอต้องการ (ถึง)
  provider       String?   // ศูนย์อบรม / โรงพยาบาล ที่ผู้ขอระบุ
  remarks        String?   // หมายเหตุจากผู้ขอ

  items         TrainingRequestItem[]
  createdAt     DateTime @default(now())
}

model TrainingRequestItem {
  id               String @id @default(uuid())
  batchId          String
  batch            TrainingRequestBatch @relation(fields: [batchId], references: [id])
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  globalTrainingId String
  globalTraining   GlobalTraining @relation(fields: [globalTrainingId], references: [id])
  clientName       String? // snapshot ชื่อ client ตอนขอ

  status            String    @default("pending") // pending | confirmed | rejected (HR ตัดสินรายคน)
  confirmedStart    DateTime? // วันที่ HR ยืนยันกับศูนย์อบรม / โรงพยาบาล
  confirmedEnd      DateTime?
  confirmedProvider String?
  hrNote            String?   // หมายเหตุจาก HR เช่น "Seat confirmed, report 07:30"
  decidedAt         DateTime?
  decidedByName     String?   // snapshot ชื่อ HR ที่ตัดสิน

  @@index([batchId])
}

model ProjectMessage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])

  content   String?  @db.Text

  attachments ProjectMessageAttachment[]

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProjectMessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName  String
  filePath  String
  fileType  String?

  createdAt DateTime @default(now())
}

model MedicalRequestBatch {
  id            String   @id @default(uuid())
  requestedById String?
  status        String   @default("pending")
  requestedBy   User?    @relation(fields: [requestedById], references: [id])

  requestedStart DateTime? // วันที่ผู้ขอต้องการ (จาก)
  requestedEnd   DateTime? // วันที่ผู้ขอต้องการ (ถึง)
  provider       String?   // ศูนย์อบรม / โรงพยาบาล ที่ผู้ขอระบุ
  remarks        String?   // หมายเหตุจากผู้ขอ

  items         MedicalRequestItem[]
  createdAt     DateTime @default(now())
}

model MedicalRequestItem {
  id         String   @id @default(uuid())
  batchId    String
  batch      MedicalRequestBatch @relation(fields: [batchId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  checkType  String?  // "Medical Check up" (default) — เผื่ออนาคตแยก Confined Space ได้
  clientName String?  // snapshot ชื่อ client ตอนขอ
  reason     String?  // snapshot สถานะตอนขอ: "overdue" / "no_record" / "due_soon"

  status            String    @default("pending") // pending | confirmed | rejected (HR ตัดสินรายคน)
  confirmedStart    DateTime? // วันที่ HR ยืนยันกับศูนย์อบรม / โรงพยาบาล
  confirmedEnd      DateTime?
  confirmedProvider String?
  hrNote            String?   // หมายเหตุจาก HR เช่น "Seat confirmed, report 07:30"
  decidedAt         DateTime?
  decidedByName     String?   // snapshot ชื่อ HR ที่ตัดสิน

  @@index([batchId])
}

model EmployeeBan {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])

  reason         String
  reasonNote     String?  @db.Text

  bannedFrom     DateTime @default(now())
  bannedUntil    DateTime
  durationMonths Int?     // ← แก้เป็น Int? (nullable)

  bannedById     String?
  bannedBy       User?    @relation("BansIssued", fields: [bannedById], references: [id])

  isActive       Boolean  @default(true)
  liftedAt       DateTime?
  liftedById     String?
  liftedBy       User?    @relation("BansLifted", fields: [liftedById], references: [id])
  liftReason     String?

  sourceTaskId   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId, isActive])
}

// ─────────────────────────────────────────────────────────
// v5.8 (draft) — Worker App: Leave, Job Confirmation, PPE, Safety Exam
// ─────────────────────────────────────────────────────────

enum LeaveType {
  sick
  personal
  vacation
  other
}

// แยกจาก MatchStatus โดยเจตนา — MatchStatus คือ client อนุมัติ candidate,
// WorkerConfirmStatus คือพนักงานเจ้าของตัวเองยืนยันรับงาน คนละ actor คนละความหมาย
enum WorkerConfirmStatus {
  pending
  confirmed
  rejected
}

// จำกัดเฉพาะช่วง pre-mobilization — mobilized/on_site ใช้ Assignment /
// Employee.mobilizationStatus ที่มีอยู่แล้ว ไม่ต้อง duplicate สถานะ
enum JobConfirmationEventType {
  received
  confirmed
  rejected
  briefed
  traveling
}

enum PPERequestStatus {
  requested
  approved
  issued
}

model LeaveRequest {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  reason    String?   @db.Text

  attachmentUrl      String?
  attachmentFileName String?

  status       String  @default("pending") // เปลี่ยนจาก ApprovalStatus → String (ดู TrainingRequestBatch/MedicalRequestBatch pattern)
  approverId   String?
  approver     User?          @relation("LeaveApprover", fields: [approverId], references: [id])
  approverNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
}

model JobConfirmationEvent {
  id          String    @id @default(uuid())
  candidateId String
  eventType    String
  note      String?  @db.Text // เหตุผลถ้า rejected, วันที่ขอเลื่อนถ้าเปลี่ยน
  timestamp DateTime @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
}

model PPERequest {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  items  Json // [{ item: "รองเท้าเซฟตี้", size: "42" }, ...]
  status PPERequestStatus @default(requested)

  requestedAt DateTime  @default(now())
  issuedAt    DateTime?

  @@index([employeeId, status])
}

model SafetyExam {
  id        String @id @default(uuid())
  title     String
  questions Json

  attempts  SafetyExamAttempt[]
  createdAt DateTime @default(now())
}

model SafetyExamAttempt {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  examId String
  exam   SafetyExam @relation(fields: [examId], references: [id])

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  score       Int?
  passed      Boolean?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId, examId])
}

// ─────────────────────────────────────────────────────────
// PE APPROVAL — ขอใช้พนักงานที่ % Match ไม่ครบ 100%
// ─────────────────────────────────────────────────────────
model MatchExceptionRequest {
  id String @id @default(uuid())

  manpowerRequestId String
  manpowerRequest   ManpowerRequest @relation(fields: [manpowerRequestId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  matchPct         Float  // % ณ ตอนขอ
  missingTrainings Json   // ["BOSIET", ...] ณ ตอนขอ
  reason           String @db.Text

  status String @default("pending") // pending / approved / rejected

  requestedById String
  requestedBy   User   @relation("MatchExceptionRequester", fields: [requestedById], references: [id])

  decidedById  String?
  decidedBy    User?     @relation("MatchExceptionDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([manpowerRequestId, employeeId]) // 1 คำขอต่อคนต่อ position request (ไม่อนุมัติ → ขอใหม่ = ทับเดิม)
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())

  // ใครทำ
  actorType  String   // "user" (ระบบหลังบ้าน) | "worker" (Worker App) | "anonymous" (เช่น login ไม่ผ่าน)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId String?  // กรณี actorType = "worker"
  actorName  String?  // snapshot ชื่อ ณ เวลาที่ทำ (ถ้า user ถูกลบ/เปลี่ยนชื่อ log ยังอ่านออก)
  actorRole  String?  // snapshot role ณ เวลาที่ทำ

  // ทำอะไร
  action     String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | LOGIN_FAILED | APPROVE | REJECT | UPLOAD | IMPORT | ...
  module     String   // workers | projects | allocation | pe_approvals | users | ...
  resourceId String?  // id ของสิ่งที่ถูกกระทำ (ถ้ามี)
  summary    String?  // ข้อความอ่านง่าย เช่น "แก้ไขข้อมูลพนักงาน 17561466 Somsak Phanteh"

  // ผลลัพธ์ + ที่มา
  success    Boolean  @default(true)
  statusCode Int?
  method     String?
  path       String?
  ip         String?
  userAgent  String?

  // รายละเอียด (ตัด password/PIN/token ออกแล้ว) + before/after ถ้า controller ส่งมา
  details    Json?

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([employeeId, createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────
// EMAIL OUTBOX — คิวอีเมลแจ้งเตือน + หลักฐาน ISO ว่าแจ้งใครเมื่อไร
// เขียนโดย services/notifyService.js · ส่งโดย services/emailWorker.js
// วางต่อท้าย schema.prisma (ไม่ต้องแก้ model อื่น)
// ─────────────────────────────────────────────────────────
model EmailOutbox {
  id            String    @id @default(uuid())
  type          String    // job_rejected / job_response_overdue / checkin_failed / match_exception_requested
  priority      String    @default("now") // urgent | now | digest
  toEmail       String
  userId        String?   // ผู้รับฝั่งระบบ (ถ้ามี)
  subject       String
  html          String    @db.Text
  text          String    @db.Text
  dedupeKey     String?   // กันส่งซ้ำ: เหตุการณ์เดียวกัน ผู้รับเดียวกัน = ฉบับเดียว
  status        String    @default("queued") // queued | sending | sent | failed | disabled
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?   @db.Text
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([dedupeKey, toEmail])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}
