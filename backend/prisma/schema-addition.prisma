// ─────────────────────────────────────────────────────────
// EMAIL OUTBOX — คิวอีเมลแจ้งเตือน + หลักฐาน ISO ว่าแจ้งใครเมื่อไร
// เขียนโดย services/notifyService.js · ส่งโดย services/emailWorker.js
// วางต่อท้าย schema.prisma (ไม่ต้องแก้ model อื่น)
// ─────────────────────────────────────────────────────────
model EmailOutbox {
  id            String    @id @default(uuid())
  type          String    // job_rejected / job_response_overdue / checkin_failed / match_exception_requested
  priority      String    @default("now") // urgent | now | digest
  toEmail       String
  userId        String?   // ผู้รับฝั่งระบบ (ถ้ามี)
  subject       String
  html          String    @db.Text
  text          String    @db.Text
  dedupeKey     String?   // กันส่งซ้ำ: เหตุการณ์เดียวกัน ผู้รับเดียวกัน = ฉบับเดียว
  status        String    @default("queued") // queued | sending | sent | failed | disabled
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?   @db.Text
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([dedupeKey, toEmail])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}
